{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Context Capsule",
  "version": "0.1.0",
  "identifier": "com.contextcapsule.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "quick",
        "title": "Context Capsule",
        "url": "/?mode=quick",
        "width": 340,
        "height": 440,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "focus": true
      },
      {
        "label": "main",
        "title": "Context Capsule",
        "url": "/?mode=full",
        "width": 1180,
        "height": 760,
        "minWidth": 680,
        "minHeight": 620,
        "visible": false,
        "resizable": true,
        "center": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["acrylic"]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/capsule",
      "binaries/capsule-agent-worker",
      "binaries/capsule-firefox-host",
      "binaries/capsule-chrome-host"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
